{
  "openapi": "3.1.0",
  "info": {"title": "ProcuChain API", "version": "0.1.0", "description": "Versioned Development API for governed procurement workflow commands."},
  "servers": [{"url": "/api/v1"}],
  "security": [{"sessionCookie": []}],
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}, "sessionCookie": {"type": "apiKey", "in": "cookie", "name": "procuchain_session"}},
    "schemas": {
      "ErrorResponse": {"type": "object", "required": ["code", "message", "correlation_id"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "correlation_id": {"type": "string"}}},
      "HealthResponse": {"type": "object", "required": ["status", "service", "api_version"], "properties": {"status": {"type": "string", "example": "ok"}, "service": {"type": "string"}, "api_version": {"type": "string", "example": "v1"}}},
      "PrincipalResponse": {"type": "object", "required": ["user_id", "display_name", "roles"], "properties": {"user_id": {"type": "string", "format": "uuid"}, "display_name": {"type": "string"}, "roles": {"type": "array", "items": {"type": "string"}}}},
      "CreatePpmpRequest": {"type": "object", "required": ["title", "content", "template_id", "template_version", "template_authority", "schema_id", "schema_version", "rule_pack_snapshot_id", "rule_pack_id", "rule_pack_hash"], "properties": {"title": {"type": "string"}, "content": {"type": "object"}, "template_id": {"type": "string"}, "template_version": {"type": "string"}, "template_authority": {"type": "string"}, "schema_id": {"type": "string"}, "schema_version": {"type": "string"}, "rule_pack_snapshot_id": {"type": "string", "format": "uuid"}, "rule_pack_id": {"type": "string"}, "rule_pack_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
      "CreateIndicativeAppRequest": {"type": "object", "required": ["title", "template_id", "template_version", "template_authority", "schema_id", "schema_version", "rule_pack_snapshot_id", "rule_pack_id", "rule_pack_hash"], "properties": {"title": {"type": "string"}, "template_id": {"type": "string"}, "template_version": {"type": "string"}, "template_authority": {"type": "string"}, "schema_id": {"type": "string"}, "schema_version": {"type": "string"}, "rule_pack_snapshot_id": {"type": "string", "format": "uuid"}, "rule_pack_id": {"type": "string"}, "rule_pack_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
      "CreateBacResolutionRequest": {"type": "object", "required": ["resolution_number", "membership", "attendance", "votes"], "properties": {"resolution_number": {"type": "string"}, "membership": {"type": "object"}, "attendance": {"type": "array", "items": {"type": "string", "format": "uuid"}}, "votes": {"type": "array", "items": {"type": "object", "required": ["user_id", "vote"], "properties": {"user_id": {"type": "string", "format": "uuid"}, "vote": {"type": "string"}}}}}},
      "CreateHopeApprovalRequest": {"type": "object", "required": ["authority_ref"], "properties": {"authority_ref": {"type": "string"}, "grounds": {"type": ["string", "null"]}}},
      "CreateSignatureRequest": {"type": "object", "required": ["purpose", "method", "declaration", "deadline"], "properties": {"purpose": {"type": "string"}, "method": {"type": "string"}, "declaration": {"type": "string"}, "deadline": {"type": "string", "format": "date-time"}}},
      "CompleteSignatureRequest": {"type": "object", "required": ["signed_at", "provider_transaction", "credential_ref", "signed_artifact_hash", "validation"], "properties": {"signed_at": {"type": "string", "format": "date-time"}, "provider_transaction": {"type": "string"}, "credential_ref": {"type": "string"}, "signed_artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "validation": {"type": "string"}}},
      "IssueAppRequest": {"type": "object", "required": ["authority_ref", "artifacts", "recipients"], "properties": {"authority_ref": {"type": "string"}, "artifacts": {"type": "array", "items": {"type": "object"}}, "recipients": {"type": "array", "items": {"type": "object"}}}},
      "RecordDeliveryRequest": {"type": "object", "required": ["channel_ref", "result", "attempted_at"], "properties": {"channel_ref": {"type": "string"}, "result": {"type": "string"}, "attempted_at": {"type": "string", "format": "date-time"}}},
      "AcknowledgeDistributionRequest": {"type": "object", "required": ["recipient_id", "artifact_hash", "method", "acknowledged_at"], "properties": {"recipient_id": {"type": "string", "format": "uuid"}, "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "method": {"type": "string"}, "declaration": {"type": ["string", "null"]}, "acknowledged_at": {"type": "string", "format": "date-time"}}},
      "CreatePpmpResponse": {"type": "object", "required": ["document_id", "version_id", "content_hash"], "properties": {"document_id": {"type": "string", "format": "uuid"}, "version_id": {"type": "string", "format": "uuid"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
      "BacResolutionResponse": {"type": "object", "required": ["resolution_id", "app_version_id", "outcome"], "properties": {"resolution_id": {"type": "string", "format": "uuid"}, "app_version_id": {"type": "string", "format": "uuid"}, "outcome": {"type": "string"}}},
      "HopeApprovalResponse": {"type": "object", "required": ["approval_id", "app_version_id", "status"], "properties": {"approval_id": {"type": "string", "format": "uuid"}, "app_version_id": {"type": "string", "format": "uuid"}, "status": {"type": "string"}}},
      "SignatureResponse": {"type": "object", "required": ["signature_request_id", "app_version_id", "status"], "properties": {"signature_request_id": {"type": "string", "format": "uuid"}, "signature_id": {"type": ["string", "null"], "format": "uuid"}, "app_version_id": {"type": "string", "format": "uuid"}, "status": {"type": "string"}}},
      "IssuanceResponse": {"type": "object", "required": ["issuance_id", "app_version_id", "distribution_ids", "manifest_hash"], "properties": {"issuance_id": {"type": "string", "format": "uuid"}, "app_version_id": {"type": "string", "format": "uuid"}, "distribution_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}}, "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
      "DistributionResponse": {"type": "object", "required": ["distribution_id", "status"], "properties": {"distribution_id": {"type": "string", "format": "uuid"}, "acknowledgement_id": {"type": ["string", "null"], "format": "uuid"}, "status": {"type": "string"}}},
      "ArtifactUploadResponse": {"type": "object", "required": ["object_key", "content_hash", "byte_length"], "properties": {"object_key": {"type": "string"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "byte_length": {"type": "integer", "format": "int64"}}},
      "CreateWorkflowTaskRequest": {"type": "object", "required": ["task_type", "subject_ref"], "properties": {"task_type": {"type": "string"}, "subject_ref": {"type": "string"}}},
      "CompleteWorkflowTaskRequest": {"type": "object", "required": ["outcome"], "properties": {"outcome": {"type": "string"}}},
      "WorkflowTaskResponse": {"type": "object", "required": ["id", "task_type", "subject_ref", "status", "row_version"], "properties": {"id": {"type": "string", "format": "uuid"}, "task_type": {"type": "string"}, "subject_ref": {"type": "string"}, "assignee_id": {"type": ["string", "null"], "format": "uuid"}, "status": {"type": "string"}, "outcome": {"type": ["string", "null"]}, "row_version": {"type": "integer", "format": "int64"}}}
    }
  },
  "paths": {
    "/auth/session": {"post": {"security": [{"bearerAuth": []}], "responses": {"201": {"description": "Session created", "headers": {"Set-Cookie": {"schema": {"type": "string"}}}}}}, "delete": {"responses": {"204": {"description": "Session revoked"}}}},
    "/health": {"get": {"security": [], "responses": {"200": {"description": "Healthy", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthResponse"}}}}}}},
    "/workflow/tasks": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateWorkflowTaskRequest"}}}}, "responses": {"201": {"description": "Workflow task created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkflowTaskResponse"}}}}}}},
    "/workflow/tasks/{task_id}": {"get": {"responses": {"200": {"description": "Workflow task", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkflowTaskResponse"}}}}}}},
    "/workflow/tasks/{task_id}/claim": {"post": {"responses": {"200": {"description": "Workflow task claimed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkflowTaskResponse"}}}}}}},
    "/workflow/tasks/{task_id}/complete": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompleteWorkflowTaskRequest"}}}}, "responses": {"200": {"description": "Workflow task completed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkflowTaskResponse"}}}}}}},
    "/me": {"get": {"responses": {"200": {"description": "Authenticated principal", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PrincipalResponse"}}}}}}},
    "/committees/{committee_id}/members": {"get": {"responses": {"200": {"description": "Committee members"}}}},
    "/ppmp": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreatePpmpRequest"}}}}, "responses": {"201": {"description": "PPMP created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreatePpmpResponse"}}}}, "409": {"description": "Idempotency conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}}}},
    "/ppmp/{version_id}": {"get": {"responses": {"200": {"description": "PPMP version"}}}},
    "/ppmp/{version_id}/indicative-app": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateIndicativeAppRequest"}}}}, "responses": {"201": {"description": "Indicative APP created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreatePpmpResponse"}}}}, "409": {"description": "Concurrency or idempotency conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}}}},
    "/app/{version_id}/bac-resolution": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateBacResolutionRequest"}}}}, "responses": {"201": {"description": "BAC resolution created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BacResolutionResponse"}}}}, "409": {"description": "Concurrency or idempotency conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}}}},
    "/app/{version_id}/hope-approval": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateHopeApprovalRequest"}}}}, "responses": {"201": {"description": "HoPE approval created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HopeApprovalResponse"}}}}, "409": {"description": "Concurrency or idempotency conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}}}},
    "/app/{version_id}/signature-request": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateSignatureRequest"}}}}, "responses": {"201": {"description": "Signature request created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SignatureResponse"}}}}, "409": {"description": "Concurrency or idempotency conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}}}},
    "/signature-requests/{request_id}/complete": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompleteSignatureRequest"}}}}, "responses": {"201": {"description": "Signature completed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SignatureResponse"}}}}, "409": {"description": "Concurrency or idempotency conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}}}},
    "/app/{version_id}/issue": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IssueAppRequest"}}}}, "responses": {"201": {"description": "APP issued", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IssuanceResponse"}}}}, "409": {"description": "Concurrency or idempotency conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}}}},
    "/issuances/{issuance_id}/artifacts/{artifact_id}": {"post": {"requestBody": {"required": true, "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}}, "responses": {"201": {"description": "Artifact stored and linked", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtifactUploadResponse"}}}}, "404": {"description": "Artifact not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}}}},
    "/documents/{version_id}/submit": {"post": {"responses": {"200": {"description": "Document submitted"}, "409": {"description": "Concurrency or idempotency conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}}}},
    "/distributions/{distribution_id}/deliver": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecordDeliveryRequest"}}}}, "responses": {"200": {"description": "Delivery recorded", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DistributionResponse"}}}}, "409": {"description": "Concurrency or idempotency conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}}}},
    "/distributions/{distribution_id}/acknowledge": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AcknowledgeDistributionRequest"}}}}, "responses": {"200": {"description": "Distribution acknowledged", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DistributionResponse"}}}}, "409": {"description": "Concurrency or idempotency conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}}}}
  }
}

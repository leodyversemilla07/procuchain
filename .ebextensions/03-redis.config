# Redis configuration for ElastiCache
# NOTE: Env vars with 'null' values break EB's get-config parser.
# Instead, we set Redis defaults in the predeploy .env generation hooks
# and only override specific values here that have non-null values.
option_settings:
  aws:elasticbeanstalk:application:environment:
    REDIS_HOST: master.procuchain-redis.jgbkz8.use1.cache.amazonaws.com
    REDIS_PORT: 6379
    REDIS_SCHEME: tls
    REDIS_CLIENT: predis
    CACHE_STORE: failover
    SESSION_DRIVER: database
    QUEUE_CONNECTION: redis

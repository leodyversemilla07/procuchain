# Redis configuration for ElastiCache
# NOTE: REDIS_PASSWORD is intentionally NOT set here.
# ElastiCache without auth token expects NO AUTH command.
# Setting REDIS_PASSWORD=null makes Predis send "AUTH null" which Redis rejects.
# Leaving it unset → env('REDIS_PASSWORD') returns PHP null → Predis skips AUTH.
option_settings:
  aws:elasticbeanstalk:application:environment:
    REDIS_HOST: master.procuchain-redis.jgbkz8.use1.cache.amazonaws.com
    REDIS_PORT: 6379
    REDIS_SCHEME: tls
    REDIS_CLIENT: predis
    REDIS_DB: 0
    REDIS_CACHE_DB: 1
    CACHE_STORE: failover
    SESSION_DRIVER: redis
    QUEUE_CONNECTION: redis

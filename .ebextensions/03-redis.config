# Redis configuration via ElastiCache
# Uses Laravel's built-in failover cache driver: tries Redis first, falls back to database then file
# This prevents config:cache from crashing during deploys when Redis is temporarily unreachable
option_settings:
  aws:elasticbeanstalk:application:environment:
    REDIS_HOST: master.procuchain-redis.jgbkz8.use1.cache.amazonaws.com
    REDIS_PORT: 6379
    REDIS_SCHEME: tls
    REDIS_PASSWORD: null
    REDIS_CLIENT: predis
    REDIS_DB: 0
    REDIS_CACHE_DB: 1
    CACHE_STORE: failover
    SESSION_DRIVER: database
    QUEUE_CONNECTION: redis

# Redis configuration for ElastiCache
# IMPORTANT: REDIS_PASSWORD must be empty (not "null") — Predis sends
# AUTH null as literal string, which ElastiCache rejects (no password set).
# Empty string => env() returns null => Predis skips AUTH entirely.
option_settings:
  aws:elasticbeanstalk:application:environment:
    REDIS_HOST: master.procuchain-redis.jgbkz8.use1.cache.amazonaws.com
    REDIS_PORT: 6379
    REDIS_SCHEME: tls
    REDIS_PASSWORD: ''
    REDIS_CLIENT: predis
    REDIS_DB: 0
    REDIS_CACHE_DB: 1
    CACHE_STORE: failover
    SESSION_DRIVER: database
    QUEUE_CONNECTION: redis

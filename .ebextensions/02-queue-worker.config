## Install the Laravel queue worker as a systemd service
##
## Problem: BlockchainWriteJob::dispatch() pushes jobs to the database
## queue, but no queue:work process was running on the EB instance.
## The postdeploy hook (04-start-queue-worker.sh) tries to start the
## service, but the .service unit file never existed — so it failed
## silently every deploy.
##
## Fix: This ebextension copies the service unit from the source bundle
## into /etc/systemd/system/ so the postdeploy hook can start it.

commands:
  01_install_queue_worker_service:
    command: |
      cp /var/app/current/.platform/worker/laravel-queue-worker.service /etc/systemd/system/laravel-queue-worker.service
      systemctl daemon-reload
      systemctl enable laravel-queue-worker
    test: test ! -f /etc/systemd/system/laravel-queue-worker.service

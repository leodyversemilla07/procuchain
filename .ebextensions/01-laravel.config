# Elastic Beanstalk Laravel configuration
# Sets document root, PHP settings, and installs packages

option_settings:
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /public
    display_errors: "Off"
    composer_options: "--optimize-autoloader --no-dev"
  aws:elasticbeanstalk:application:environment:
    APP_ENV: production
    APP_DEBUG: "false"
    LOG_CHANNEL: stderr

packages:
  yum:
    jq: []

# Elastic Beanstalk Laravel configuration
# Sets document root, PHP settings, packages, and environment variables

option_settings:
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /public
    display_errors: "Off"
    composer_options: "--optimize-autoloader --no-dev"
  aws:elasticbeanstalk:application:environment:
    APP_ENV: production
    APP_DEBUG: "false"
    LOG_CHANNEL: stderr
    DB_HOST: procuchain-db.ciraiim6k0r7.us-east-1.rds.amazonaws.com
    DB_PORT: "3306"
    DB_DATABASE: procuchain
    DB_USERNAME: admin
    DB_PASSWORD: Procuchain2024!

packages:
  yum:
    jq: []

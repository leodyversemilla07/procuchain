# Add Laravel log to EB tail logs
# Also create a diagnostic script that runs on deploy

files:
  /opt/elasticbeanstalk/tasks/taillogs.d/laravel-logs.conf:
    content: |
      /var/app/current/storage/logs/laravel.log
    group: root
    mode: "000755"
    owner: root
  /opt/diagnostic.sh:
    content: |
      #!/bin/bash
      echo "=== ENV CHECK ==="
      cd /var/app/current
      php artisan env 2>&1 || echo "env command failed"
      echo "=== STORAGE PERMISSIONS ==="
      ls -la storage/logs/
      echo "=== .env file ==="
      cat .env | grep -E "^(APP_KEY|DB_|APP_ENV)" | head -20
    mode: "000755"
    owner: root

container_commands:
  99_diagnostic:
    command: "/opt/diagnostic.sh"

# Elastic Beanstalk Laravel artisan commands
# Runs during deployment after the app is staged but before it goes live

container_commands:
  01_migrate:
    command: "php artisan migrate --force"
  02_config_cache:
    command: "php artisan config:cache"
  03_route_cache:
    command: "php artisan route:cache"
  04_view_cache:
    command: "php artisan view:cache"
  05_storage_link:
    command: "php artisan storage:link"
  06_chmod_storage:
    command: "chmod -R 775 storage bootstrap/cache"
  07_chown_storage:
    command: "chown -R webapp:webapp storage bootstrap/cache"

files:
  /opt/elasticbeanstalk/tasks/taillogs.d/laravel-logs.conf:
    content: |
      /var/app/current/storage/logs/laravel.log
    group: root
    mode: "000755"
    owner: root

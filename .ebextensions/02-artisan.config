# Elastic Beanstalk Laravel post-deploy commands
# Only non-blocking, safe commands here
# DO NOT run migrate — do that manually via eb ssh or SSM

container_commands:
  01_storage_link:
    command: "php artisan storage:link || true"
  02_chmod_storage:
    command: "chmod -R 775 storage bootstrap/cache"
  03_chown_storage:
    command: "chown -R webapp:webapp storage bootstrap/cache"
  04_view_cache:
    command: "php artisan view:cache || true"

## Build Vite frontend assets during EB deployment
## AL2023 ships Node.js 20 by default on the PHP platform.
## We install Node.js 24 via dnf and set it as active using alternatives.
## container_commands run on /var/app/staging/ before the app goes live.
## NPM_USE_PRODUCTION=false ensures devDependencies (vite, etc.) are installed.

commands:
  01_install_node24:
    command: "dnf install -y nodejs24 nodejs24-npm"
    test: "[ ! -f /usr/bin/node-24 ] && echo 'node24 not installed'"

  02_set_node24_default:
    command: "alternatives --set node /usr/bin/node-24"

option_settings:
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: NPM_USE_PRODUCTION
    value: "false"

container_commands:
  01_check_node:
    command: "echo 'Node: $(node -v) — npm: $(npm -v) — cwd: $(pwd)' > /tmp/npm-debug.log"
    cwd: "/var/app/staging"

  02_npm_install:
    command: "npm install 2>&1 | tee -a /tmp/npm-debug.log"
    cwd: "/var/app/staging"

  03_npm_build:
    command: "npm run build 2>&1 | tee -a /tmp/npm-debug.log"
    cwd: "/var/app/staging"

## Build Vite frontend assets during EB deployment
## Node.js v20+ is pre-installed on the AL2023 PHP platform.
## container_commands run on /var/app/staging/ before the app goes live.
## NPM_USE_PRODUCTION=false ensures devDependencies (vite, etc.) are installed.

option_settings:
  - namespace: aws:elasticbeanstalk:application:environment
    option_name: NPM_USE_PRODUCTION
    value: "false"

container_commands:
  01_npm_install:
    command: "npm install"
    cwd: "/var/app/staging"

  02_npm_build:
    command: "npm run build"
    cwd: "/var/app/staging"

# Verify nginx config after postdeploy hook

container_commands:
  01_verify_staging_nginx:
    command: |
      echo "=== Checking staging nginx.conf for client_max_body_size ==="
      grep -n 'client_max_body_size' /var/proxy/staging/nginx/nginx.conf || echo "NOT FOUND in nginx.conf"
      echo "=== Checking conf.d files ==="
      grep -rn 'client_max_body_size' /var/proxy/staging/nginx/conf.d/ || echo "NOT FOUND in conf.d"
      echo "=== nginx config test ==="
      nginx -t -c /var/proxy/staging/nginx/nginx.conf

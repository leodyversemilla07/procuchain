# Increase PHP-FPM pool limits for large file uploads

files:
  "/etc/php-fpm.d/zzz-upload-limits.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      ; Override PHP-FPM pool settings for large file uploads
      request_terminate_timeout = 300s
      request_slowlog_timeout = 120s
      php_admin_value[upload_max_filesize] = 100M
      php_admin_value[post_max_size] = 100M
      php_admin_value[max_execution_time] = 300
      php_admin_value[max_input_time] = 300
      php_admin_value[memory_limit] = 512M

container_commands:
  01_restart_php_fpm:
    command: "systemctl restart php-fpm || systemctl restart php8.4-fpm || service php-fpm restart || service php8.4-fpm restart"

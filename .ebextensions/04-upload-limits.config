# Increase PHP upload limits for file uploads
# Nginx: override existing client_max_body_size in nginx.conf via container_commands

files:
  "/etc/php.d/99-upload-limits.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      upload_max_filesize = 100M
      post_max_size = 100M
      memory_limit = 512M
      max_execution_time = 300
      max_input_time = 300

container_commands:
  01_restart_php:
    command: "systemctl restart php-fpm || systemctl restart php8.4-fpm || service php-fpm restart || service php8.4-fpm restart"
  02_override_nginx_limit:
    command: |
      STAGING_NGINX="/var/proxy/staging/nginx/nginx.conf"
      # Remove any existing client_max_body_size directive
      sed -i '/client_max_body_size/d' "$STAGING_NGINX"
      # Add our value to http block
      sed -i '/http {/a\    client_max_body_size 200M;' "$STAGING_NGINX"
      # Also clean any conf.d files that might have it
      for f in /var/proxy/staging/nginx/conf.d/*.conf; do
        [ -f "$f" ] && sed -i '/client_max_body_size/d' "$f"
      done
      nginx -t -c /var/proxy/staging/nginx/nginx.conf

# Increase PHP upload limits for file uploads
# Nginx limit: override existing client_max_body_size in nginx.conf

files:
  "/etc/php.d/99-upload-limits.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      upload_max_filesize = 100M
      post_max_size = 100M
      memory_limit = 512M
      max_execution_time = 300
      max_input_time = 300
  "/etc/nginx/client_max_body_size_override.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      client_max_body_size 200M;

container_commands:
  01_restart_php:
    command: "systemctl restart php-fpm || systemctl restart php8.4-fpm || service php-fpm restart || service php8.4-fpm restart"
  02_override_nginx_limit:
    command: |
      # Replace existing client_max_body_size in nginx.conf
      if grep -q 'client_max_body_size' /etc/nginx/nginx.conf; then
        sed -i 's/client_max_body_size [0-9]\+[KMGT]*;/client_max_body_size 200M;/' /etc/nginx/nginx.conf
        nginx -t && systemctl reload nginx
      else
        echo "client_max_body_size not found in nginx.conf, adding to http block"
        sed -i '/http {/a\    client_max_body_size 200M;' /etc/nginx/nginx.conf
        nginx -t && systemctl reload nginx
      fi

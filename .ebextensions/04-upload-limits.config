# Increase PHP upload limits for file uploads
# Nginx limits handled by .platform/nginx/conf.d/proxy.conf

files:
  "/etc/php.d/99-upload-limits.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      upload_max_filesize = 100M
      post_max_size = 100M
      memory_limit = 512M
      max_execution_time = 300
      max_input_time = 300

container_commands:
  01_restart_php:
    command: "systemctl restart php-fpm || systemctl restart php8.4-fpm || service php-fpm restart || service php8.4-fpm restart"

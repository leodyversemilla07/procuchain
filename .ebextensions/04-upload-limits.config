# Increase upload limits for file uploads
# Fixes HTTP 413 Payload Too Large

files:
  "/etc/nginx/conf.d/proxy.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      client_max_body_size 100M;
      proxy_read_timeout 300s;
      proxy_send_timeout 300s;

  "/etc/php.d/99-upload-limits.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      upload_max_filesize = 100M
      post_max_size = 100M
      memory_limit = 512M
      max_execution_time = 300
      max_input_time = 300

container_commands:
  01_reload_nginx:
    command: "systemctl reload nginx || service nginx reload"
  02_restart_php:
    command: "systemctl restart php-fpm || service php-fpm restart || systemctl restart php8.4-fpm || service php8.4-fpm restart"

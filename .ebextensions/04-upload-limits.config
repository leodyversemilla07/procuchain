# Increase PHP upload limits for file uploads
# Fixes HTTP 413 Payload Too Large

files:
  "/etc/php.d/99-upload-limits.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      upload_max_filesize = 100M
      post_max_size = 100M
      memory_limit = 512M
      max_execution_time = 300
      max_input_time = 300

container_commands:
  01_restart_php:
    command: "systemctl restart php-fpm || systemctl restart php8.4-fpm || service php-fpm restart || service php8.4-fpm restart"
  02_verify_nginx_config:
    command: "grep -r 'client_max_body_size' /etc/nginx/ || true"
  03_set_nginx_limit:
    command: |
      if grep -q 'http {' /etc/nginx/nginx.conf; then
        sed -i '/http {/a\    client_max_body_size 200M;' /etc/nginx/nginx.conf
        nginx -t && systemctl reload nginx
      else
        echo "http block not found in nginx.conf"
        exit 1
      fi

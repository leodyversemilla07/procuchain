# Laravel Scheduler Cron
# Runs the artisan schedule:run command every minute as the webapp user
files:
  "/etc/cron.d/laravel-scheduler":
    mode: "000644"
    owner: root
    group: root
    content: |
      * * * * * webapp /usr/bin/php /var/app/current/artisan schedule:run >> /var/app/current/storage/logs/scheduler.log 2>&1

commands:
  01_set_cron_permissions:
    command: "chmod 644 /etc/cron.d/laravel-scheduler"
  02_ensure_cron_running:
    command: "systemctl start crond 2>/dev/null || systemctl start cron 2>/dev/null || true"

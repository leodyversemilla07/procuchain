APP_NAME=ProcuChain
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=procuchain
DB_USERNAME=root
DB_PASSWORD=

# For local quick start you can switch to sqlite by setting:
# DB_CONNECTION=sqlite
# and commenting the mysql credentials above.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_DRIVER=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_user
MAIL_PASSWORD=your_smtp_pass
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_EMAIL=support@example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# MultiChain RPC Configuration
MULTICHAIN_HOST=127.0.0.1
MULTICHAIN_PORT=4786
MULTICHAIN_USERNAME=multichainrpc
MULTICHAIN_PASSWORD=change_me
MULTICHAIN_CHAIN_NAME=procuchain
MULTICHAIN_USE_SSL=false
MULTICHAIN_VERIFY_SSL=false
MULTICHAIN_NODE_ADDRESS=127.0.0.1:4787
MULTICHAIN_CONNECTION_TIMEOUT=30
MULTICHAIN_MAX_RETRIES=3

# MultiChain Role Addresses (generated by: php artisan multichain:setup)
MULTICHAIN_BAC_SECRETARIAT_ADDRESS=default_bac_secretariat_address
MULTICHAIN_BAC_CHAIRMAN_ADDRESS=default_bac_chairman_address
MULTICHAIN_HOPE_ADDRESS=default_hope_address
MULTICHAIN_ADMIN_ADDRESS=default_admin_address

# VAPID Keys for WebPush Notifications
VAPID_PUBLIC_KEY="BJrbQ105xhnxsDvnOHsfR4_jDyZrfQzLv96ltBXsIh6BmSpvg3bxCHNpkOCrimXbG1lDBGo7MOIhvLiv0vlk1Z4"
VAPID_PRIVATE_KEY="bWTXlYVlIR2PjzZ76GQQhppdxvOZE95MuXuhaTYJbJ8"
VAPID_SUBJECT="mailto:admin@procuchain.com"

VITE_APP_NAME="${APP_NAME}"

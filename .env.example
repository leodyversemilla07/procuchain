APP_NAME=ProcuChain
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=procuchain
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
# Use database for queue
QUEUE_CONNECTION=database
# Use database for cache
CACHE_DRIVER=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your_email@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_EMAIL=your_email@gmail.com

AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_DEFAULT_REGION=sgp1
AWS_BUCKET=your_bucket_name
AWS_ENDPOINT=https://sgp1.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# VAPID Keys for WebPush Notifications
VAPID_PUBLIC_KEY="VAPID_PUBLIC_KEY_PLACEHOLDER"
VAPID_PRIVATE_KEY="VAPID_PRIVATE_KEY_PLACEHOLDER"
VAPID_SUBJECT="mailto:admin@example.com"

VITE_APP_NAME="${APP_NAME}"

MULTICHAIN_HOST=your_multichain_host_or_127.0.0.1
MULTICHAIN_PORT=4786
MULTICHAIN_USERNAME=multichainrpc
MULTICHAIN_PASSWORD=your_multichain_password
MULTICHAIN_CHAIN_NAME=procuchain
MULTICHAIN_P2P_PORT=6271
MULTICHAIN_WEB_PORT=7448
MULTICHAIN_NODE_ADDRESS=your_public_ip:6271

MULTICHAIN_HOPE_ADDRESS=your_hope_address
MULTICHAIN_BAC_SECRETARIAT_ADDRESS=your_bac_secretariat_address
MULTICHAIN_BAC_CHAIRMAN_ADDRESS=your_bac_chairman_address
MULTICHAIN_ADMIN_ADDRESS=your_admin_address

MULTICHAIN_USE_SSL=false
MULTICHAIN_VERIFY_SSL=false

MULTICHAIN_CONNECTION_TIMEOUT=30
MULTICHAIN_MAX_RETRIES=3

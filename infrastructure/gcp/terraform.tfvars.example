# =============================================================================
# Example Terraform Variables File
# =============================================================================
# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to version control
# =============================================================================

# Required
project_id = "your-gcp-project-id"

# Optional - Override defaults as needed
region           = "asia-southeast1"  # Singapore
zone             = "asia-southeast1-b"
secondary_zone   = "asia-southeast1-c"
backup_region    = "asia-northeast1"  # Tokyo

environment = "production"

# Network
vpc_name    = "procuchain-vpc"
subnet_cidr = "10.0.1.0/24"

# MultiChain
chain_name         = "procuchain"
multichain_version = "2.3.3"
rpc_port           = 6486
p2p_port           = 6487
rpc_username       = "multichainrpc"

# Compute instances
admin_node_machine_type   = "n2-standard-2"  # 2 vCPU, 8GB
app_node_machine_type     = "n2-standard-2"  # 2 vCPU, 8GB
witness_node_machine_type = "e2-medium"      # 2 vCPU, 4GB
backup_node_machine_type  = "e2-medium"      # 2 vCPU, 4GB

boot_disk_size_gb         = 20
data_disk_size_gb         = 50
witness_data_disk_size_gb = 30

# Access control - IMPORTANT: Set these for production
allowed_ssh_ranges = [
  # "YOUR_OFFICE_IP/32",  # Your office IP
  # "YOUR_VPN_IP/32",     # VPN IP
]

app_server_ips = [
  # "10.0.0.0/8",         # Internal network
  # "YOUR_APP_SERVER_IP", # App server IP
]

# Backup - leave empty to auto-create bucket
backup_bucket_name    = ""
backup_retention_days = 30

# Labels
labels = {
  application = "procuchain"
  component   = "blockchain"
  environment = "production"
  managed_by  = "terraform"
}
